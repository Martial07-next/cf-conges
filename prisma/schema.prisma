generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COLLABORATEUR
  COMPTABLE
  EMPLOYEUR
  ADMIN
}

enum StatutCompte {
  EN_ATTENTE
  ACTIF
  DESACTIVE
}

enum StatutDemande {
  EN_ATTENTE
  VALIDE
  REFUSE
  ANNULE
}

model User {
  id                String       @id @default(cuid())
  nom               String
  prenom            String
  email             String       @unique
  motDePasseHash    String
  role              Role         @default(COLLABORATEUR)
  service           String?
  equipe            String?
  managerId         String?
  manager           User?        @relation("Hierarchie", fields: [managerId], references: [id])
  equipeMembres     User[]       @relation("Hierarchie")
  statutCompte      StatutCompte @default(EN_ATTENTE)
  recevoirEmails    Boolean      @default(true)
  ongletsActifs     String[]     @default([])
  soldeInitialSaisi Boolean      @default(false)
  ordre             Int          @default(0)
  visiblePlanning  Boolean      @default(true)
  teletravailAutorise Boolean   @default(false)
  teletravailJoursMax Int       @default(0)
  teletravailJours    String[]  @default([])
  teletravailOverrides TeletravailOverride[]
  estAlternant Boolean @default(false)
  tuteurId     String?
  tuteur       User?   @relation("TuteurAlternant", fields: [tuteurId], references: [id])
  alternants   User[]  @relation("TuteurAlternant")
  doitChangerMotDePasse Boolean  @default(false)
  dateEntree        DateTime?
  dateSortie DateTime?
  createdAt         DateTime     @default(now())
  leaveBalances LeaveBalance[]
  livraisonsTR TicketRestauLivraison[]
  pushSubscriptions PushSubscription[]
  ticketsTRRegularises      TicketRestauRegularisation[] @relation("TRRegularisationUser")
  ticketsTRRegularisesPar   TicketRestauRegularisation[] @relation("TRRegularisationCreatedBy")
  leaveRequests LeaveRequest[] @relation("Demandeur")
  validations   LeaveRequest[] @relation("Validateur")
  joursFerieDecisions JourFerieDecision[]
  notifications Notification[]
  auditLogs     AuditLog[]
  bugReports    BugReport[]
}

model LeaveType {
  id                String   @id @default(cuid())
  code              String   @unique
  libelle           String
  couleur           String
  comptabiliseSolde Boolean  @default(true)
  demandable        Boolean  @default(true)
  retireTicketRestau Boolean @default(true)
  plafondAnnuel     Int?
  ordre             Int      @default(0)
  createdAt         DateTime @default(now())

  balances LeaveBalance[]
  requests LeaveRequest[]
  motifs   LeaveTypeMotif[]
}

model LeaveTypeMotif {
  id          String   @id @default(cuid())
  leaveTypeId String
  libelle     String
  jours       Float
  ordre       Int      @default(0)
  createdAt   DateTime @default(now())

  leaveType LeaveType      @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  requests  LeaveRequest[]
}

model LeaveBalance {
  id          String @id @default(cuid())
  userId      String
  leaveTypeId String
  annee       Int
  joursAcquis Float  @default(0)
  joursPris   Float  @default(0)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([userId, leaveTypeId, annee])
}

model LeaveRequest {
  id               String        @id @default(cuid())
  userId           String
  leaveTypeId      String
  motifId          String?
  dateDebut        DateTime
  dateFin          DateTime
  demiJournee      Boolean       @default(false)
  demiJourneePeriode String?
  motif            String?
  exceptionnelle   Boolean       @default(false)
  statut           StatutDemande @default(EN_ATTENTE)
  valideParId      String?
  dateValidation   DateTime?
  commentaireRefus String?
  pieceJointeNom   String?
  creeParAdmin     Boolean       @default(false)
  gereParAlternant Boolean @default(false)
  annulationDemandee     Boolean   @default(false)
  motifAnnulation        String?
  dateDemandeAnnulation  DateTime?
  masqueDashboard        Boolean   @default(false)
  masqueDemandes         Boolean   @default(false)
  masqueHistoriqueAdmin  Boolean   @default(false)
  supprimeParAdmin       Boolean   @default(false)
  createdAt        DateTime      @default(now())

  user      User            @relation("Demandeur", fields: [userId], references: [id], onDelete: Cascade)
  valideur  User?           @relation("Validateur", fields: [valideParId], references: [id])
  leaveType LeaveType       @relation(fields: [leaveTypeId], references: [id])
  motifFixe LeaveTypeMotif? @relation(fields: [motifId], references: [id])
}

model Notification {
  id      String   @id @default(cuid())
  userId  String
  type    String
  message String
  lu      Boolean  @default(false)
  date    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id     String   @id @default(cuid())
  userId String?
  action String
  cible  String?
  date   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model AccrualRun {
  id            String   @id @default(cuid())
  moisAnnee     String   @unique
  executeLe     DateTime @default(now())
  nombreComptes Int
}

model BugReport {
  id        String   @id @default(cuid())
  userId    String?
  message   String
  page      String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model TicketRestauRegularisation {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime
  commentaire String?
  createdById String
  createdAt   DateTime @default(now())

  user      User @relation("TRRegularisationUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User @relation("TRRegularisationCreatedBy", fields: [createdById], references: [id])

  @@unique([userId, date])
}

model JourFerieDecision {
  id                 String        @id @default(cuid())
  userId             String
  date               DateTime
  souhaiteTravailler Boolean
  statut             StatutDemande @default(EN_ATTENTE)
  commentaireRefus   String?
  createdAt          DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model TeletravailOverride {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  type      String   // "RETRAIT" ou "AJOUT"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model TicketRestauLivraison {
  id         String   @id @default(cuid())
  annee      Int
  mois       Int
  livreLe    DateTime @default(now())
  livreParId String

  livrePar User @relation(fields: [livreParId], references: [id])

  @@unique([annee, mois])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
